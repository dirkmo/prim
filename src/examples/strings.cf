\ Counted strings use UTF-8 byte lengths, including raw and empty strings.
:tx $ffff c! ;
:count dup 1+ swap c@ ;
:type dup [ while ] 1- >r dup c@ tx 1+ r> dup [ repeat ] 2drop ;
:message "Grüße 🙂" ;
:raw #"Raw ä"
:empty #""
:syntax ( " ignored \ [ ) ( second comment ) "\ ( )" ;
:main
    message count type 32 tx
    'raw count type 32 tx
    'empty count type "" count type syntax count type
    13 tx 10 tx
;
[ 0x21 0 c! 'main 1 ! 1 3 c! 0x22 4 c! ]
