\ Requires bootstrap and generated opcode words.
:2>r, swap, >r, >r, ;
:2r>, r>, r>, swap, ;
:=, -, not, ;
:2dup, over, over, ;
:boot! 'H @ >r 0 'H ! push, , call, break, r> 'H ! ;
:2drop drop drop ;
:1+ 1 + ;
:1+, push8, 1 c, +, ;
:1- 1 - ;
:1-, push8, 1 c, -, ;
:if push, 'H @ $ffff , jz, ;
:else push, 'H @ >r $ffff , jp, 'H @ swap ! r> ;
:then 'H @ swap ! ;
:while 'H @ push, 'H @ 0xffff , jz, ;
:repeat push, swap , jp, 'H @ swap ! ;
:do 'H @ dup, push, 'H @ $ffff , jz, >r, ;
:loop r>, push8, 1 c, -, push, swap , jp, 'H @ swap ! drop, ;
:for 2>r, 'H @ 2r>, 2dup, 2>r, -, push, 'H @ $ffff , jz, ;
:next r>, 1+, >r, push, swap , jp, 'H @ swap ! rdrop, rdrop, ;
:i r> r> swap over >r >r ;
:0= [ if ] 0 [ else ] $ffff [ then ] ;
:0<> [ if ] $ffff [ else ] 0 [ then ] ;
