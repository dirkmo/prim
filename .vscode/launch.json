{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "tokenizer base.cf",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "prim",
            "args": ["tokenize", "-i", "base.cf", "-o", "base.tok.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "tokenforth base.tok",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "prim",
            "args": ["compile", "-i", "base.tok.toml", "-o", "base.tf.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "tokenizer test.cf",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "prim",
            "args": ["tokenize", "-i", "test.cf", "-o", "test.tok.toml", "-it", "base.tf.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "tokenforth test.tok",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "prim",
            "args": ["compile", "-i", "test.tok.toml", "-o", "test.tf.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            //"console": "externalTerminal",
            "justMyCode": true
        }
    ]
}