{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "tokenizer base.cf",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "prim",
            "args": ["tokenize", "-i", "src/base.cf", "-o", "build/src/base.tok.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "tokenforth base.tok",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "prim",
            "args": ["compile", "-i", "build/src/base.tok.toml", "-o", "build/src/base.tf.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "tokenizer test.cf",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "prim",
            "args": ["tokenize", "-i", "src/test.cf", "-o", "build/src/test.tok.toml", "-it", "build/src/base.tf.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "tokenforth test.tok",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "prim",
            "args": ["compile", "-i", "build/src/test.tok.toml", "-o", "build/src/test.tf.toml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            //"console": "externalTerminal",
            "justMyCode": true
        }
    ]
}