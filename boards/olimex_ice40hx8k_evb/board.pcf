# Olimex Rev.B official netlist, U4 ball names (CT256).
set_io clk_100mhz J3
set_io button_n K11
# Debug UART on free iCE40-IO Rev.A pass-through GPIOs:
# adapter TX -> GPIO1.5 / FPGA RX; adapter RX <- GPIO1.7 / FPGA TX.
set_io -pullup yes uart_rx E4
set_io uart_tx B2
# iCE40-IO Rev.A PS/2 resistor-divider inputs, GPIO1.14 clock / .16 data.
set_io ps2_clk G1
set_io ps2_data J5
# iCE40-IO Rev.A: GPIO1.20 HSYNC, GPIO1.18 VSYNC.
set_io vga_hsync J4
set_io vga_vsync H2
# RGB bus [2:0] maps to expansion signals COLOR1/2/3 (470R/1k/1.8k).
# RED1/2/3: GPIO1.27/29/34.
set_io vga_red[2] E3
set_io vga_red[1] H5
set_io vga_red[0] F3
# GREEN1/2/3: GPIO1.32/30/28.
set_io vga_green[2] H3
set_io vga_green[1] F2
set_io vga_green[0] H6
# BLUE1/2/3: GPIO1.26/24/22.
set_io vga_blue[2] F1
set_io vga_blue[1] H4
set_io vga_blue[0] G2
set_io leds[0] M12
set_io leds[1] R16
set_io sram_cs_n T6
set_io sram_oe_n L9
set_io sram_we_n T7
set_io sram_addr[0] N6
set_io sram_addr[1] T1
set_io sram_addr[2] P4
set_io sram_addr[3] R2
set_io sram_addr[4] N5
set_io sram_addr[5] T2
set_io sram_addr[6] P5
set_io sram_addr[7] R3
set_io sram_addr[8] R5
set_io sram_addr[9] T3
set_io sram_addr[10] R4
set_io sram_addr[11] M7
set_io sram_addr[12] N7
set_io sram_addr[13] P6
set_io sram_addr[14] M8
set_io sram_addr[15] T5
set_io sram_addr[16] R6
set_io sram_addr[17] P8
set_io sram_data[0] T8
set_io sram_data[1] P7
set_io sram_data[2] N9
set_io sram_data[3] T9
set_io sram_data[4] M9
set_io sram_data[5] R9
set_io sram_data[6] K9
set_io sram_data[7] P9
set_io sram_data[8] R10
set_io sram_data[9] L10
set_io sram_data[10] P10
set_io sram_data[11] N10
set_io sram_data[12] T10
set_io sram_data[13] T11
set_io sram_data[14] T15
set_io sram_data[15] T14
